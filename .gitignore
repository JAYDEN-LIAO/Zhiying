# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.whl

# ── 桌面壳构建产物（PyInstaller onedir 部署到项目根，不入库）──
/_internal/
/智影桌面端.exe
*.lnk

# ── 安装包构建产物（Inno Setup 输出，不入 git；交付走上 SVN TestVersion）──
/Bin/

# ── Test / coverage ──
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Mypy ──
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/

# ── Runtime data (gitignored — generated by pipeline) ──
data/
models/
weights/

# ModelScope cache lock
.lock

# ── 机器本地下载/组装产物（内嵌 PG vendor/pg、FFmpeg vendor/ffmpeg 等，不入库）──
/vendor/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Python venv ──
.venv/
venv/

# ── Temp ──
/tmp/
.cache/
*.tmp
*.bak

# ── Ad-hoc query/analysis scripts ──
_query_*.py
_notes_*.md

# ── Video files (too large for git) ──
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.dav

# ── Secrets (API keys, credentials) ──
config/secrets.yaml
.env
.env.*
!.env.example
*.log

# ── Local reference docs (not part of the project) ──
*.docx

# ── Frontend ──
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.eslintcache
# ── 桌面前端（与服务器前端完全独立）──
frontend-desktop/node_modules/
frontend-desktop/dist/
frontend-desktop/.vite/
frontend-desktop/*.tsbuildinfo
frontend-desktop/.eslintcache
frontend-desktop/.env
# ── 新 Web 前端（轻量化解析工作台，复用 frontend-shared）──
frontend-web/node_modules/
frontend-web/.vite/
frontend-web/*.tsbuildinfo
frontend-web/.eslintcache
frontend-web/.env
# mock 演示视频有意入库（*.mp4 全局忽略的例外；7.35s CC0 示例，<1MB）
!frontend-web/public/mock/flower.mp4
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI detection (installed via cargo install aicheck)
/aidetection/

# ── 机器相关主配置（各机各改，不入库；模板见 config/config.yaml.example）──
config/config.yaml
/data/backend.log

# 服务器部署参考（含凭证，绝不入库）
docs/server.md

# 软件管家许可凭证（封装态根目录，绝不入库）
license.dat

# ── SVN 备份凭证（绝不入库）──
config/svn.local.json
