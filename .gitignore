# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.whl

# ── Test / coverage ──
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Mypy ──
.mypy_cache/

# ── Runtime data (gitignored — generated by pipeline) ──
data/
models/

# ModelScope cache lock
.lock

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Python venv ──
.venv/
venv/

# ── Temp ──
/tmp/

# ── Ad-hoc query/analysis scripts ──
_query_*.py
_notes_*.md

# ── Video files (too large for git) ──
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.dav

# ── Secrets (API keys, credentials) ──
config/secrets.yaml
.env
*.log

# ── Frontend ──
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
