*.py[cod]
*.egg-info/
dist/
build/
*.whl

# ── Test / coverage ──
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Mypy ──
.mypy_cache/
.ruff_cache/
.pyright/
.tox/
.nox/

# ── Runtime data (gitignored — generated by pipeline) ──
data/
models/
weights/

# ModelScope cache lock
.lock

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Python venv ──
.venv/
venv/

# ── Temp ──
/tmp/
.cache/
*.tmp
*.bak

# ── Ad-hoc query/analysis scripts ──
_query_*.py
_notes_*.md

# ── Video files (too large for git) ──
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.dav

# ── Secrets (API keys, credentials) ──
config/secrets.yaml
.env
.env.*
!.env.example
*.log

# ── Local reference docs (not part of the project) ──
*.docx

# ── Frontend ──
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI detection (installed via cargo install aicheck)
/aidetection/

# ── Windows 部署产物（机器相关绝对路径，由 setup_windows.ps1 重新生成）──
/config/config.windows.yaml
/data/backend.log
/data/.cerno_keys.tmp.json
