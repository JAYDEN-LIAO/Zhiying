#!/usr/bin/env bash
# Zhiying 版本号一键提升（随仓库分发，任意开发机 git pull 后即可用）
#
# 用法:
#   ./bump minor        # 0.22.0 → 0.23.0（新功能：中间位 +1）
#   ./bump patch        # 0.22.0 → 0.22.1（修 bug：末位 +1）
#   ./bump 0.24.0       # 直接指定完整版本号
#   ./bump --dry-run minor  # 只预览会改成什么，不改文件
#   ./bump              # 查看当前版本
#
# 真实逻辑在 scripts/bump_version.py（联动改 core/version.py + frontend 两个文件）
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "$DIR/scripts/bump_version.py" "$@"
