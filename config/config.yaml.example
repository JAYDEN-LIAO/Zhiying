# ═══════════════════════════════════════════════════════════
# Zhiying 配置模板 — 机器相关配置请复制到 config/config.yaml 后修改。
# 注意：config/config.yaml 已 gitignore，各机各改（服务器改 storage 路径等）。
# ═══════════════════════════════════════════════════════════

server:
  host: "0.0.0.0"
  port: 8011

database:
  uri: "postgresql+asyncpg://zhiying:zhiying@localhost:5432/zhiying"

storage:
  video_dir: "data/videos"
  artifact_dir: "data/artifacts"

plugins:
  # ── 语音转录（Demo 跳过）──
  transcriber:
    backend: null

  # ── 镜头分割（TransNetV2 神经网络，真实镜头边界检测）──
  segmenter:
    backend: "transnetv2"
    params:
      threshold: 0.5
      scene_min_duration: 1.0

  # ── 物体检测 + 追踪（YOLO11 + 内置 BoT-SORT，默认启用）──
  detector:
    backend: yolo
    model: models/yolo26s.pt
    confidence_threshold: 0.4
    iou_threshold: 0.5
    batch_size: 128
    detection_fps: 10
    imgsz: 640               # YOLO 推理分辨率（低显存可 512/416，激活近似减半）

  # ── OCR（Demo 跳过）──
  ocr:
    backend: null

  # ── 画面描述 via DashScope API（默认，vlm_llm 摘要模式）──
  # 注意：摘要默认走 API 模式。native_video（本地视频原生理解）已置灰退役，
  # 本地 captioner 8B（Qwen3-VL-8B-Instruct）不再下载——download_models.py 不含该项。
  captioner:
    backend: "qwen_api"
    params:
      base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
      api_key: "placeholder"  # 实际值在 config/secrets.yaml 或设置页填写
      model_name: "qwen-vl-max"
      with_context: true

  # ── 画面描述 via Qwen3-VL 8B 本地视频理解（可选：仅开发机有本地 8B 模型时启用）──
  # captioner:
  #   backend: "qwen3_vl"
  #   params:
  #     model_name: "models/Qwen/Qwen3-VL-8B-Instruct"
  #     max_new_tokens: 2048
  #     min_pixels: 200704
  #     max_pixels: 1003520

  # ── 向量编码（本地 GPU）──
  embedder:
    backend: "qwen3_vl_embedding_8b"
    params:
      model_name: "models/Qwen/Qwen3-VL-Embedding-8B"
      # 编码分辨率 [宽, 高] — 影响速度与语义精度
      # 336×224: ~70 vision tokens/帧, 速度快, 语义级搜索足够
      # 504×336: ~160 vision tokens/帧, 更细粒度, 速度约为 2×
      encode_width: 336
      encode_height: 224
      # 量化：none / 8bit / 4bit — 低显存机器把 ~16GB 权重降到 ~8GB / ~4GB
      # 需 bitsandbytes（pip install bitsandbytes）；⚠️ 启动时加载，改后需重启后端
      quantization: "none"

  # ── 摘要生成 via DeepSeek API（vlm_llm 模式使用）──
  summarizer:
    backend: "vllm"
    base_url: "https://api.deepseek.com/v1"
    api_key: "placeholder"  # 实际值在 config/secrets.yaml
    model_name: "deepseek-chat"
    max_tokens: 2048
    temperature: 0.1

  # ── 动态 Grounding（Demo 跳过）──
  grounding:
    backend: null

  # ── 人脸识别（SCRFD + ArcFace R50 via insightface）──
  face:
    backend: "insightface"
    params:
      det_thresh: 0.5              # SCRFD 检测阈值
      rec_thresh: 0.4              # ArcFace 识别阈值（内部用，聚类由 FaceRunner 做）

  # ── 车牌识别（HyperLPR3 — 专用 LPR 模型）──
  plate:
    backend: "hyperlpr"
    params:
      detect_level: "high"      # low (更快) / high (更准, 640×640)

pipeline:
  sample_fps: 1.0
  scene_min_duration: 1.0
  # chunk 编码：默认关闭（8GB GPU 上帧+文本路已足够）
  # 开启需要较好 GPU（≥12GB VRAM），并确认 encode_video 不 OOM
  chunk_encoding: false
  # NVDEC 硬解 — GPU 硬件解码 + MJPEG pipe 传输 (~100KB/帧)
  # 需要 NVIDIA GPU + FFmpeg 编译 CUDA 支持；不可用时自动 fallback 到 cv2
  use_nvdec: true
  # 并发管道上限：0 = 不限（默认）；>0 时同一时刻最多 N 个视频管道同时处理。
  # 24GB 等低显存机器建议 1（激活峰值按并发数叠加，静态权重不叠加）
  max_concurrent_videos: 0
  # 默认摘要模式：vlm_llm（API 驱动，默认）；native_video 已置灰退役（后端代码保留兼容历史记录）
  default_summary_mode: "vlm_llm"

  # ── 编码速度预设 — 控制搜索精度与处理时间的权衡 ──
  # 每个预设定义分辨率 + 批大小；逐视频可在参数面板选择
  default_encode_profile: "balanced"
  encode_profiles:
    fast:
      label: "快速"
      desc: "低分辨率 + 大批量，1h 视频约 3min"
      encode_width: 336
      encode_height: 224
      encode_batch_size: 512
    balanced:
      label: "平衡"
      desc: "中等分辨率，速度精度兼顾（默认）"
      encode_width: 504
      encode_height: 336
      encode_batch_size: 512
    precise:
      label: "精准"
      desc: "高分辨率，适合精细检索"
      encode_width: 672
      encode_height: 448
      encode_batch_size: 256
