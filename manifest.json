{
  "schemaVersion": "1.0",
  "bridgeVersion": "1.0",
  "requiredScopes": [],
  "contributions": [],
  "automations": [
    {
      "id": "zhiying-video-analysis",
      "label": "智影视频分析",
      "event": "file.uploaded",
      "enabled": true,
      "accepts": {
        "categories": ["video"],
        "contentTypes": ["video/*"],
        "extensions": [
          "mp4",
          "mov",
          "avi",
          "mkv",
          "webm",
          "m4v",
          "flv",
          "ts"
        ],
        "maxFileSize": 21474836480
      },
      "handler": {
        "type": "http",
        "path": "/internal/yunzhi/jobs"
      },
      "retry": {
        "maxAttempts": 3,
        "delaysSeconds": [5, 15, 30]
      }
    }
  ]
}
